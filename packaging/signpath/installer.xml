<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the installer, made from the already signed files
     (build.yml, "Sign the installer"). A copy of what's set on signpath.io. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="UTMTFTM-Setup-${version}.exe" product-name="UTMTFTM" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
